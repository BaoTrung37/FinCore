{
  "info": {
    "name": "FinCore API (M1 - M4)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" },
    { "key": "access_token", "value": "" },
    { "key": "account_id", "value": "" },
    { "key": "destination_account_id", "value": "" },
    { "key": "transfer_id", "value": "" },
    { "key": "payment_id", "value": "" }
  ],
  "item": [
    {
      "name": "Platform",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/healthz"
          }
        }
      ]
    },
    {
      "name": "Auth (M1)",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const data = pm.response.json();",
                  "  pm.collectionVariables.set('access_token', data.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{base_url}}/api/v1/auth/register"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  pm.collectionVariables.set('access_token', data.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{base_url}}/api/v1/auth/login"
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/v1/auth/me"
          }
        }
      ]
    },
    {
      "name": "Accounts (M2)",
      "item": [
        {
          "name": "Create Account (VND)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const data = pm.response.json();",
                  "  pm.collectionVariables.set('account_id', data.ID || data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currency\": \"VND\"\n}"
            },
            "url": "{{base_url}}/api/v1/accounts"
          }
        },
        {
          "name": "List Accounts",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/v1/accounts"
          }
        },
        {
          "name": "Get Account",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/v1/accounts/{{account_id}}"
          }
        },
        {
          "name": "Freeze Account",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/v1/accounts/{{account_id}}/freeze"
          }
        },
        {
          "name": "Unfreeze Account",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/v1/accounts/{{account_id}}/unfreeze"
          }
        },
        {
          "name": "Get Balance",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/v1/accounts/{{account_id}}/balance"
          }
        },
        {
          "name": "Get Transactions",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/v1/accounts/{{account_id}}/transactions?limit=20&offset=0"
          }
        }
      ]
    },
    {
      "name": "Transfers (M3)",
      "item": [
        {
          "name": "Create Transfer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  pm.collectionVariables.set('transfer_id', data.id || data.ID);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source_account_id\": \"{{account_id}}\",\n  \"destination_account_id\": \"{{destination_account_id}}\",\n  \"amount\": 100000,\n  \"currency\": \"VND\"\n}"
            },
            "url": "{{base_url}}/api/v1/transfers"
          }
        },
        {
          "name": "Get Transfer",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/v1/transfers/{{transfer_id}}"
          }
        }
      ]
    },
    {
      "name": "Payments (M4)",
      "item": [
        {
          "name": "Initiate Deposit",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  pm.collectionVariables.set('payment_id', data.id || data.ID);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account_id\": \"{{account_id}}\",\n  \"amount\": 500000,\n  \"currency\": \"VND\",\n  \"bank_code\": \"MOCK_VCB\",\n  \"bank_account_number\": \"1234567890\"\n}"
            },
            "url": "{{base_url}}/api/v1/payments/deposits"
          }
        },
        {
          "name": "Initiate Withdrawal",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account_id\": \"{{account_id}}\",\n  \"amount\": 150000,\n  \"currency\": \"VND\",\n  \"bank_code\": \"MOCK_VCB\",\n  \"bank_account_number\": \"1234567890\"\n}"
            },
            "url": "{{base_url}}/api/v1/payments/withdrawals"
          }
        },
        {
          "name": "List Payments",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/v1/payments?limit=20&offset=0"
          }
        },
        {
          "name": "Get Payment",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/v1/payments/{{payment_id}}"
          }
        }
      ]
    },
    {
      "name": "Webhooks (M5)",
      "item": [
        {
          "name": "Create Webhook Endpoint",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const data = pm.response.json();",
                  "  pm.collectionVariables.set('webhook_id', data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://webhook.site/example\",\n  \"events\": [\"transfer.completed\", \"payment.completed\", \"reconciliation.run_completed\"]\n}"
            },
            "url": "{{base_url}}/api/v1/webhooks"
          }
        },
        {
          "name": "List Webhook Endpoints",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/v1/webhooks"
          }
        },
        {
          "name": "Delete Webhook Endpoint",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/v1/webhooks/{{webhook_id}}"
          }
        }
      ]
    },
    {
      "name": "Reconciliation (M6)",
      "item": [
        {
          "name": "Create Reconciliation Run (JSON)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const data = pm.response.json();",
                  "  pm.collectionVariables.set('recon_run_id', data.id);",
                  "  if (data.items && data.items.length > 0) {",
                  "    pm.collectionVariables.set('recon_item_id', data.items[0].id);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bank_code\": \"MOCK_VCB\",\n  \"currency\": \"VND\",\n  \"period_start\": \"2026-01-01T00:00:00Z\",\n  \"period_end\": \"2026-12-31T23:59:59Z\",\n  \"records\": [\n    {\n      \"external_ref\": \"MDEP-EXAMPLE\",\n      \"direction\": \"deposit\",\n      \"amount\": 500000,\n      \"currency\": \"VND\",\n      \"status\": \"completed\"\n    }\n  ]\n}"
            },
            "url": "{{base_url}}/api/v1/reconciliation/runs"
          }
        },
        {
          "name": "List Reconciliation Runs",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/v1/reconciliation/runs?limit=20&offset=0"
          }
        },
        {
          "name": "Get Reconciliation Run Details",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/v1/reconciliation/runs/{{recon_run_id}}"
          }
        },
        {
          "name": "Resolve Discrepancy Item",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resolution_status\": \"resolved\",\n  \"resolution_note\": \"Verified against bank settlement statement\"\n}"
            },
            "url": "{{base_url}}/api/v1/reconciliation/runs/{{recon_run_id}}/items/{{recon_item_id}}"
          }
        },
        {
          "name": "Run Ledger Integrity Audit",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/v1/reconciliation/ledger-audit"
          }
        },
        {
          "name": "List Ledger Integrity Audits",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/v1/reconciliation/ledger-audit?limit=20&offset=0"
          }
        }
      ]
    },
    {
      "name": "Observability (M7)",
      "item": [
        {
          "name": "Prometheus Metrics",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/metrics"
          }
        }
      ]
    }
  ]
}
