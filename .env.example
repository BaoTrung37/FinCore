POSTGRES_DB=fincore
POSTGRES_USER=fincore_app
POSTGRES_PASSWORD=local_dev_password
POSTGRES_PORT=5432

APP_ENV=local
HTTP_PORT=8080
DATABASE_URL=postgres://fincore_app:local_dev_password@localhost:5432/fincore?sslmode=disable
JWT_SECRET=change-this-local-dev-secret-to-32-plus-chars
JWT_EXPIRATION=24h
LOG_LEVEL=info
AUTO_MIGRATE=true
